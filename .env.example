# Every setting in backend/app/config.py. Defaults here match the code, so a
# bare clone runs with no .env at all; docker-compose overrides what it needs.

# SQLite by default so the project runs with zero infrastructure.
# docker-compose sets postgresql+psycopg2://since:since@postgres/since
DATABASE_URL=sqlite:///./data/watchlist.db

# Empty means the per-process in-memory cache. Required only when the API and
# worker run as separate processes; the demo runs them in one.
REDIS_URL=

# "replay" plays the recorded session against a virtual clock. "yfinance"
# hits the live provider (see Known issues in backend/README.md).
MARKET_PROVIDER=replay
REPLAY_FIXTURE=./data/session.jsonl

# Virtual seconds per wall second. Must stay below
# STALE_AFTER_SECONDS / POLL_INTERVAL_OPEN (= 18) or every quote is stale
# before the next poll and every digest row renders as degraded.
REPLAY_SPEED=10.0

# Poll cadence in seconds, by market state.
POLL_INTERVAL_OPEN=5
POLL_INTERVAL_PREOPEN=30
POLL_INTERVAL_CLOSED=600

# Standard deviations of the symbol's own 30-day return distribution before a
# move counts as a signal at all.
Z_THRESHOLD=1.5
# Relative volume confirming a move is participation-backed.
RVOL_THRESHOLD=1.8
# Overnight gap, as a fraction, that counts as a news event.
GAP_THRESHOLD=0.02
# Residual return (stock minus beta x index) that counts as stock-specific.
RESIDUAL_THRESHOLD=0.015

# Rows the digest may surface, however violent the session. The bar floats to
# fill this; the constant in the system is the user's attention.
ATTENTION_BUDGET=5

# A quote older than this renders as stale rather than current.
STALE_AFTER_SECONDS=90

# Sigma from the last accepted price beyond which a tick is quarantined.
TICK_SANITY_SIGMA=12.0
